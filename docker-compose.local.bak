services:
  db:
    image: mysql:8.0
    container_name: cms_nhomc_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: cms_nhomc
      MYSQL_USER: cms_nhomc
      MYSQL_PASSWORD: cms_nhomc
      MYSQL_ROOT_PASSWORD: root
    volumes:
      - db_data:/var/lib/mysql
      - ./db:/docker-entrypoint-initdb.d
    command: --default-authentication-plugin=mysql_native_password

  wordpress:
    image: wordpress:latest
    container_name: cms_nhomc_wordpress
    depends_on:
      - db
    restart: unless-stopped
    ports:
      - '8082:80'
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_NAME: cms_nhomc
      WORDPRESS_DB_USER: cms_nhomc
      WORDPRESS_DB_PASSWORD: cms_nhomc
      WORDPRESS_TABLE_PREFIX: wp_
    volumes:
      - ./wordpress:/var/www/html

volumes:
  db_data:
